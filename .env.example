# ─────────────────────────────────────────────
# قاعدة البيانات (مطلوب)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ─────────────────────────────────────────────
# أمان الأدمن — JWT (مطلوب)
# ولّد قيمة عشوائية: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────
JWT_SECRET=replace-with-random-256bit-hex-string

# ─────────────────────────────────────────────
# رابط الموقع (مطلوب للـ SEO والـ OG)
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─────────────────────────────────────────────
# Cloudflare Turnstile CAPTCHA (اختياري)
# احصل على المفاتيح من: https://dash.cloudflare.com → Turnstile
# ─────────────────────────────────────────────
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
# TURNSTILE_SECRET_KEY=your-secret-key

# ─────────────────────────────────────────────
# Umami Analytics (اختياري)
# ─────────────────────────────────────────────
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://your-umami-domain/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id

# ─────────────────────────────────────────────
# HappySeeds (لا تغيّره)
# ─────────────────────────────────────────────
REACTUS_BASE_URL=https://reactus-api.happyseeds.ai
HAPPYSEEDS_PROJECT_ID=
